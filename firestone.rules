rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user may read/write only their own profile document.
    // Includes: digestFrequency, summaryDepth, notificationFrequency, notificationsPaused, breakingAlerts
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Saved articles subcollection or collection
    match /savedArticles/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // Ratings
    match /ratings/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
    }
  }
}